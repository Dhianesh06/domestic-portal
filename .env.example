# ==============================================================================
# DomesticPortal Environment Configuration Example
# Copy this file to '.env' for local development:
#   cp .env.example .env
# NOTE: Never commit '.env' containing real secrets to version control!
# ==============================================================================

# Active Spring Profile (options: local, dev, uat, prod)
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# Database Fallback Configuration (Used if AWS Secrets Manager is disabled)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://127.0.0.1:3306/mobiversa?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=your_local_db_username
DB_PASSWORD=your_local_db_password

# ------------------------------------------------------------------------------
# AWS Secrets Manager Configuration
# ------------------------------------------------------------------------------
# Enable or disable AWS Secrets Manager integration (true/false)
AWS_SECRETS_ENABLED=false

# AWS Region where your secret is hosted
AWS_REGION=ap-southeast-1

# AWS Secret Name or full ARN in Secrets Manager
AWS_SECRET_NAME=domestic-portal/local/db-credentials

# AWS Static Credentials (ONLY for local development if not using ~/.aws/credentials)
# In Dev, UAT, and Prod, leave these empty so IAM Role is used automatically.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ------------------------------------------------------------------------------
# Application Security (JWT)
# ------------------------------------------------------------------------------
APP_JWT_SECRET=your_256_bit_jwt_secret_key_here_minimum_32_characters_long

